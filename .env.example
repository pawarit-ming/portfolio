# Copy this file to `.env.local` and fill in the values.
# `.env.local` is git-ignored — never commit real keys.

# Canonical site URL, used for metadata, sitemap.xml and OG images.
#
# Optional. Leave it unset locally (falls back to http://localhost:3000), and on
# Vercel the project's production domain is picked up automatically. Set it only
# to override that — a custom domain, for instance. A bare hostname is fine; the
# scheme is added for you.
#
# Do not create this variable with an empty value: an empty string is a value,
# not an absence, and older builds treated it as one.
NEXT_PUBLIC_SITE_URL=

# --- Contact form (Resend: https://resend.com) ---
# Without RESEND_API_KEY the form returns a clear "not configured" message
# instead of silently dropping the enquiry.
RESEND_API_KEY=
# Where enquiries are delivered. Defaults to the email in lib/data.ts.
CONTACT_TO_EMAIL=
# Sender address. `onboarding@resend.dev` works out of the box for testing;
# switch to an address on your own verified domain for production.
CONTACT_FROM_EMAIL=Portfolio <onboarding@resend.dev>
